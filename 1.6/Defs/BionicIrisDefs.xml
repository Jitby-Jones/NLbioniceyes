<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_Bionic</defName>
    <label>bionic eye iris</label>
    <hediffs>
      <li>BionicEye</li>
    </hediffs>
    <texPath>Things/Pawn/BionicIrises/Bionic</texPath>
  </BionicIrises.BionicIrisDef>

  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_AdvancedBionic</defName>
    <label>advanced bionic eye iris</label>
    <hediffs>
      <li MayRequire="vat.epoeforked">AdvancedBionicEye</li>
      <li MayRequire="FrozenSnowFox.AdvancedBionicsExpansion">FSFAdvBionicEye</li>
    </hediffs>
    <texPath>Things/Pawn/BionicIrises/AdvancedBionic</texPath>
  </BionicIrises.BionicIrisDef>

  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_TacticalBionic</defName>
    <label>tactical bionic eye iris</label>
    <hediffs>
      <li MayRequire="vat.epoeforked">EPIA_TacticalBionicEye</li>
    </hediffs>
    <texPath>Things/Pawn/BionicIrises/TacticalBionic</texPath>
  </BionicIrises.BionicIrisDef>

  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_Archotech</defName>
    <label>archotech eye iris</label>
    <hediffs>
      <li>ArchotechEye</li>
    </hediffs>
    <texPath>Things/Pawn/BionicIrises/Archotech</texPath>
  </BionicIrises.BionicIrisDef>

  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_Artificial</defName>
    <label>artificial eye iris</label>
    <hediffs>
      <li MayRequire="JoeDaly.MedMeds.MO">ArtificialMedEye</li>
      <li MayRequire="NunahurAlShamikh.MedP">ArtificialMedEye</li>
    </hediffs>
    <matchNames>
      <li>artificial</li>
    </matchNames>
    <texPath>Things/Pawn/BionicIrises/Artificial</texPath>
  </BionicIrises.BionicIrisDef>

  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_Mechanical</defName>
    <label>mechanical eye iris</label>
    <hediffs>
      <li MayRequire="JoeDaly.MedMeds.MO">MechanicalMedEye</li>
      <li MayRequire="NunahurAlShamikh.MedP">MechanicalMedEye</li>
    </hediffs>
    <matchNames>
      <li>mechanical</li>
    </matchNames>
    <texPath>Things/Pawn/BionicIrises/Mechanical</texPath>
  </BionicIrises.BionicIrisDef>

  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_Paresian</defName>
    <label>Paresian eye iris</label>
    <hediffs>
      <li MayRequire="JoeDaly.MedMeds.MO">AmbroisenMedEye</li>
      <li MayRequire="NunahurAlShamikh.MedP">AmbroisenMedEye</li>
    </hediffs>
    <matchNames>
      <li>paresian</li>
      <li>ambroisen</li>
    </matchNames>
    <texPath>Things/Pawn/BionicIrises/Paresian</texPath>
  </BionicIrises.BionicIrisDef>

  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_LightReceptor</defName>
    <label>light receptor iris</label>
    <hediffs>
      <li MayRequire="zal.eyeprosthetics">EPR_LightReceptor</li>
    </hediffs>
    <matchNames>
      <li>light receptor</li>
      <li>lightreceptor</li>
    </matchNames>
    <texPath>Things/Pawn/BionicIrises/LightReceptor</texPath>
  </BionicIrises.BionicIrisDef>

  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_RoyalBionic</defName>
    <label>royal bionic eye iris</label>
    <hediffs>
      <li MayRequire="zal.eyeprosthetics,Ludeon.RimWorld.Royalty">EPR_RoyalBionicEye</li>
    </hediffs>
    <matchNames>
      <li>royal bionic</li>
      <li>royalbionic</li>
    </matchNames>
    <texPath>Things/Pawn/BionicIrises/RoyalBionic</texPath>
  </BionicIrises.BionicIrisDef>

  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_Glass</defName>
    <label>glass eye</label>
    <hediffs>
      <li MayRequire="zal.eyeprosthetics">EPR_GlassEye</li>
    </hediffs>
    <matchNames>
      <li>glass eye</li>
      <li>glasseye</li>
    </matchNames>
    <naturalEye>true</naturalEye>
  </BionicIrises.BionicIrisDef>

  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_Blind</defName>
    <label>blind eye iris</label>
    <blindEye>true</blindEye>
    <texPath>Things/Pawn/BionicIrises/Blind</texPath>
  </BionicIrises.BionicIrisDef>

  <BionicIrises.BionicIrisDef>
    <defName>BionicIris_Eyeless</defName>
    <label>empty eye socket</label>
    <missingEye>true</missingEye>
    <texPath>Things/Pawn/BionicIrises/Eyeless</texPath>
  </BionicIrises.BionicIrisDef>
</Defs>
